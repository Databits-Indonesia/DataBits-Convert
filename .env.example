# Environment Variables for OAuth Configuration
# These are OPTIONAL - app works without them (local file upload only)
# See OAUTH_SETUP.md for detailed configuration instructions

# Google Drive API (Optional)
# Get from: https://console.developers.google.com/
VITE_GOOGLE_CLIENT_ID=

# Microsoft OneDrive (Optional)
# Get from: https://portal.azure.com/
VITE_ONEDRIVE_CLIENT_ID=

# Dropbox (Optional)
# Get from: https://www.dropbox.com/developers/apps
VITE_DROPBOX_CLIENT_ID=

# App Version (Optional)
VITE_APP_VERSION=1.0.0
