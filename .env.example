# Environment Variables for OAuth Configuration

# Google Drive API
# Get from: https://console.developers.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Microsoft OneDrive
# Get from: https://portal.azure.com/
VITE_ONEDRIVE_CLIENT_ID=your_onedrive_client_id_here

# Dropbox
# Get from: https://www.dropbox.com/developers/apps
VITE_DROPBOX_CLIENT_ID=your_dropbox_app_key_here
